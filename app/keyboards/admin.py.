    keyboard.add(
        InlineKeyboardButton(
            "🔙 بازگشت به مدیریت",
            callback_data="admin_dashboard",
        )
    )

    return keyboard


def force_membership_keyboard(channels) -> InlineKeyboardMarkup:
    keyboard = InlineKeyboardMarkup()

    for channel in channels:
        if channel.invite_link:
            keyboard.add(
                InlineKeyboardButton(
                    f"📢 عضویت در {channel.title}",
                    url=channel.invite_link,
                )
            )

    keyboard.add(
        InlineKeyboardButton(
            "✅ بررسی عضویت",
            callback_data="admin_check_membership",
        )
    )

    return keyboard
